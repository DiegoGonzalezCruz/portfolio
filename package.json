{
  "name": "portafolio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ads:campaign": "node --env-file=.env.ads ads/create-campaign.mts",
    "ads:status": "node --env-file=.env.ads ads/status.mts",
    "ads:set-status": "node --env-file=.env.ads ads/set-status.mts",
    "report:weekly": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.ads reports/weekly.mts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@flodlc/nebula": "^1.0.56",
    "@vercel/oidc-aws-credentials-provider": "^3.3.18",
    "botid": "1.5.11",
    "lottie-react": "^3.1.2",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "google-auth-library": "^11.3.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
